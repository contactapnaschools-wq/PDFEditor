{
  "name": "pdf-editor",
  "version": "0.1.0",
  "description": "Framework-agnostic PDF editor custom element for Angular, React, and plain HTML.",
  "type": "module",
  "sideEffects": [
    "./dist/pdf-editor.js"
  ],
  "main": "./dist/pdf-editor.js",
  "module": "./dist/pdf-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pdf-editor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "lit": "^3.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
